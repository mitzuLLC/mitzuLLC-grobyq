<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>grobyq</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Grobyq</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <NuGetAudit>false</NuGetAudit>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>grobyq by mitzu LLC</Product>
    <AssemblyTitle>grobyq</AssemblyTitle>
    <Company>mitzu LLC</Company>
    <Version>3.6.8</Version>
    <FileVersion>3.6.8.0</FileVersion>
    <Configuration>Release</Configuration>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
  <!-- logo assets, loaded by name (Brand.Img) -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\*.png" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\*.gz" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\*.bin" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\*.txt" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Lang\*.json" LogicalName="lang.%(Filename).json" />
  </ItemGroup>
</Project>
