<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the tray icon (NotifyIcon + its menu). WPF has no tray control of its own. Implicit usings are
         off, so no WinForms namespace leaks into the WPF code: Ui/Tray.cs references it fully qualified. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>grobyq</AssemblyName>
    <RootNamespace>Grobyq</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>4.0.3</Version>
    <FileVersion>4.0.3.0</FileVersion>
    <Product>grobyq by mitzu LLC</Product>
    <Company>mitzu LLC</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- v4.0 needs admin for thread-priority / affinity on other processes (same as the WinForms build). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- out-of-BCL on net8: WMI (Fingerprint/GrobLic/SysInfo) and ServiceController (Cleaner). Registry, crypto
         and BigInteger are built into net8.0-windows and need no package. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- logo / icon assets, referenced by pack URI (/Assets/..) -->
    <Resource Include="Assets\*.png" />
    <!-- interface languages: English is the key, these map English -> translation (L.Load reads lang.<code>.json) -->
    <EmbeddedResource Include="Lang\ru.json" LogicalName="lang.ru.json" />
    <EmbeddedResource Include="Lang\uk.json" LogicalName="lang.uk.json" />
    <!-- startup animation (94 JPEG frames, "GQSP") and the built-in system thread profile (System thread optimizer) -->
    <EmbeddedResource Include="Assets\splash.bin" LogicalName="splash.bin" />
    <EmbeddedResource Include="Assets\system-threads.txt" LogicalName="system-threads.txt" />
  </ItemGroup>

</Project>
