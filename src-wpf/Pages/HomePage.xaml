<UserControl x:Class="Grobyq.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Bg}">
        <StackPanel Margin="40,36,40,0" MaxWidth="760" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/glyph_96.png" Height="52" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="grobyq" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Fg}" />
                    <TextBlock x:Name="VersionText" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <Border Background="{StaticResource Card}" CornerRadius="8" Padding="18" Margin="0,22,0,0"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="SYSTEM" Foreground="#6B7177" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock x:Name="CpuText" Foreground="{StaticResource Fg}" FontSize="14" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="13" Margin="0,22,0,0"
                       Text="THREADS оптимизирует игру. AFFINITY закрепляет ядра и прерывания. Обслуживание — очистка системы и журнал." />

        </StackPanel>
    </Grid>
</UserControl>
