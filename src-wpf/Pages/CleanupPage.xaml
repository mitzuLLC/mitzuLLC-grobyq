<UserControl x:Class="Grobyq.Pages.CleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Acc}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Opacity="{TemplateBinding Opacity}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource Bg}">
        <StackPanel DockPanel.Dock="Top" Margin="40,36,40,0">
            <TextBlock Text="Очистка системы" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Fg}" />
            <TextBlock Text="Временные файлы, кэши, логи. Сначала «Сканировать», затем «Очистить выбранное»."
                       Foreground="{StaticResource Dim}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="ScanBtn"  Style="{StaticResource Btn}" Content="Сканировать" Click="OnScan" />
                <Button x:Name="CleanBtn" Style="{StaticResource Btn}" Background="{StaticResource Side}"
                        Content="Очистить выбранное" Click="OnClean" Margin="8,0,0,0" />
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Dim}" VerticalAlignment="Center"
                           Margin="12,0,0,0" FontSize="12.5" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Rows" Margin="40,18,40,40" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
