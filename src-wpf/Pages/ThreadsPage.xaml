<UserControl x:Class="Grobyq.Pages.ThreadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="BigBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Bg}">
        <StackPanel Margin="40,36,40,0" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="Потоки" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Fg}" />
            <TextBlock Text="Оптимизация приоритетов потоков и фоновых процессов под игру."
                       Foreground="{StaticResource Dim}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />

            <Border Background="{StaticResource Side}" CornerRadius="10" Padding="20" Margin="0,22,0,0"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StateDot" Width="11" Height="11" VerticalAlignment="Center" />
                        <TextBlock x:Name="StateText" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource Fg}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="TargetText" Foreground="{StaticResource Dim}" FontSize="12.5" Margin="0,6,0,0" />
                    <Button x:Name="ToggleBtn" Style="{StaticResource BigBtn}" Click="OnToggle"
                            Height="42" Width="200" HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="НАСТРОЙКИ" Foreground="#6B7177" FontSize="11" FontWeight="SemiBold" Margin="2,26,0,10" />
            <CheckBox x:Name="SwAuto"    Click="OnSwitch" Tag="AutoEnable"      Content="Включать автоматически при старте" />
            <CheckBox x:Name="SwThreads" Click="OnSwitch" Tag="DoThreads"       Content="Приоритеты потоков игры" />
            <CheckBox x:Name="SwBg"      Click="OnSwitch" Tag="DoBackground"    Content="Понижать фоновые процессы, пока игра в фокусе" />
            <CheckBox x:Name="SwReapply" Click="OnSwitch" Tag="PeriodicReapply" Content="Периодическое переприменение (держит приоритеты)" />

        </StackPanel>
    </Grid>
</UserControl>
