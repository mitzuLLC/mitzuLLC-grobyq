<UserControl x:Class="Grobyq.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource Acc}" />
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource Bg}">
        <StackPanel Margin="40,36,40,0" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="grobyq" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Fg}" />
            <TextBlock x:Name="VersionText" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,2,0,0" />

            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="13" Margin="0,20,0,0"
                       Text="Core-aware оптимизатор потоков и привязки под киберспорт. Приоритеты потоков, affinity, прерывания и фон — под стабильный frame-time в CS2." />

            <TextBlock Text="ССЫЛКИ" Foreground="#6B7177" FontSize="11" FontWeight="SemiBold" Margin="0,26,0,8" />
            <TextBlock FontSize="13" Margin="0,0,0,4">
                <Hyperlink NavigateUri="https://x.com/grobPC" RequestNavigate="OnNav">x.com/grobPC</Hyperlink>
            </TextBlock>
            <TextBlock FontSize="13" Margin="0,0,0,4">
                <Hyperlink NavigateUri="https://grobpc.com" RequestNavigate="OnNav">grobpc.com</Hyperlink>
            </TextBlock>
            <TextBlock FontSize="13" Margin="0,0,0,4">
                <Hyperlink NavigateUri="https://t.me/grobPC" RequestNavigate="OnNav">t.me/grobPC</Hyperlink>
            </TextBlock>
            <TextBlock FontSize="13" Margin="0,0,0,4">
                <Hyperlink NavigateUri="https://aerialos.vercel.app" RequestNavigate="OnNav">aerialos.vercel.app</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
