<UserControl x:Class="Grobyq.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="{StaticResource Fg}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Acc}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{StaticResource Bg}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,36,40,40" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="Настройки" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Fg}" />

            <TextBlock Text="СПИСОК ИГР (WATCH LIST)" Foreground="#6B7177" FontSize="11" FontWeight="SemiBold" Margin="0,24,0,6" />
            <TextBlock Style="{StaticResource Hint}" Text="Процессы, за которыми следит grobyq. Через пробел, напр.: cs2.exe dota2.exe" />
            <TextBox x:Name="WatchBox" />

            <TextBlock Text="ПЕРИОД ПЕРЕПРИМЕНЕНИЯ (мс)" Foreground="#6B7177" FontSize="11" FontWeight="SemiBold" Margin="0,18,0,6" />
            <TextBlock Style="{StaticResource Hint}" Text="Как часто держатся приоритеты, пока игра запущена. Меньше = чаще (минимум 1000)." />
            <TextBox x:Name="PeriodBox" Width="160" HorizontalAlignment="Left" />

            <Button x:Name="SaveBtn" Style="{StaticResource Btn}" Content="Сохранить" Click="OnSave"
                    HorizontalAlignment="Left" Margin="0,16,0,0" Width="160" />
            <TextBlock x:Name="SavedText" Foreground="{StaticResource Ok}" FontSize="12" Margin="0,8,0,0" />

            <TextBlock Text="ДОПОЛНИТЕЛЬНО" Foreground="#6B7177" FontSize="11" FontWeight="SemiBold" Margin="0,26,0,10" />
            <CheckBox x:Name="SwSystem" Click="OnSwitch" Tag="SystemThreadOpt" Content="Встроенный профиль системных потоков" />
            <CheckBox x:Name="SwBgAff"  Click="OnSwitch" Tag="BgAffinity"      Content="Фоновым процессам — только фоновые ядра" />
            <CheckBox x:Name="SwBgFg"   Click="OnSwitch" Tag="BgForeground"    Content="Понижать фон только когда игра в фокусе" />
            <CheckBox x:Name="SwAff"    Click="OnSwitch" Tag="DoAffRules"      Content="Применять правила привязки (affinity)" />
            <CheckBox x:Name="SwSkip0"  Click="OnSwitch" Tag="SkipCpu0"        Content="Не трогать CPU0" />
            <CheckBox x:Name="SwTray"   Click="OnSwitch" Tag="CloseToTray"     Content="Сворачивать в трей" />

            <Button Style="{StaticResource Btn}" Background="{StaticResource Side}" Content="Открыть папку конфигурации"
                    Click="OnOpenFolder" HorizontalAlignment="Left" Margin="0,22,0,0" Width="240" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
