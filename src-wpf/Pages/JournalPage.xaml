<UserControl x:Class="Grobyq.Pages.JournalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Grobyq">
    <UserControl.Resources>
        <local:LevelToBrush x:Key="LevelBrush" />
    </UserControl.Resources>

    <!-- The v3 log tab: a 30 px bar (caption + Hide / Clear / Copy), then the monospace log on #09090B.
         English on purpose: it is A/B evidence and must read the same on every PC. -->
    <DockPanel Background="{StaticResource LogBg}">
        <Border DockPanel.Dock="Top" Background="{StaticResource Side}" Height="34"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock x:Name="Caption" Foreground="{StaticResource Dim}" FontWeight="SemiBold"
                           FontSize="11.33" VerticalAlignment="Center" Margin="16,0,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="CopyBtn"  Style="{StaticResource BtnGhost}" Height="26" MinWidth="60" Padding="10,0" Margin="4,0,0,0" Click="OnCopy" />
                    <Button x:Name="ClearBtn" Style="{StaticResource BtnGhost}" Height="26" MinWidth="60" Padding="10,0" Margin="4,0,0,0" Click="OnClear" />
                    <Button x:Name="HideBtn"  Style="{StaticResource BtnGhost}" Height="26" MinWidth="60" Padding="10,0" Margin="4,0,0,0" Click="OnHide" />
                </StackPanel>
            </Grid>
        </Border>

        <ListBox x:Name="List" Background="{StaticResource LogBg}" BorderThickness="0" Padding="0,8,0,8"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="12">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="12,1,8,2">
                        <TextBlock Text="{Binding Time}" Foreground="{StaticResource Faint}" Width="70" />
                        <TextBlock Text="{Binding Tag}"  Width="70"
                                   Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" />
                        <TextBlock Text="{Binding Text}"
                                   Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
