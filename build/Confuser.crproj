<?xml version="1.0" encoding="utf-8"?>
<!--
  grobyq v4.0 — ConfuserEx2 obfuscation profile (anti-theft / anti-reverse).
  Runs in CI (stage 3) over the published exe. Paths are relative to THIS file (build/):
    baseDir  ..\publish    (where dotnet publish put grobyq.exe)
    outputDir ..\protected (where the obfuscated exe is written; CI signs + packages from here)

  Protection layers applied to the WHOLE module (safe with WPF):
    anti ildasm  — blocks ildasm from opening it
    constants    — encrypts string/numeric constants (your license logic, endpoints, keys-in-code are no longer plaintext)
    ctrl flow    — scrambles method control flow (decompilers emit spaghetti, not your logic)
    anti debug   — resists attaching a debugger (dnSpy live-debug)
    anti tamper   — the exe refuses to run if its IL was modified (a cracked/patched copy won't launch)
    ref proxy    — hides direct API calls behind proxies

  RENAME is applied ONLY to the engine namespace (Grobyq.Core). WPF/XAML resolves types & properties BY NAME at
  runtime, so renaming view types breaks bindings — those are intentionally left un-renamed. Once the WPF project
  exists and namespaces are final, we tune this (CI will surface any XAML breakage on the first run).
-->
<project outputDir="..\protected" baseDir="..\publish" xmlns="http://confuser.codeplex.com">

  <!-- whole module: the non-rename layers, safe for WPF -->
  <rule pattern="true" preset="none" inherit="false">
    <protection id="anti ildasm" />
    <protection id="constants" />
    <protection id="ctrl flow" />
    <protection id="anti debug" />
    <protection id="anti tamper" />
    <protection id="ref proxy" />
  </rule>

  <!-- rename only the engine/logic layer (no XAML touches these). Tighten/loosen once namespaces are final. -->
  <rule pattern="namespace('Grobyq.Core')" preset="none" inherit="false">
    <protection id="rename" />
  </rule>

  <module path="grobyq.exe" />
</project>
